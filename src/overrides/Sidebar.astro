---
import sidebar from "../config/sidebar.js";

// Heroicons SVGs (outline style)
const icons = {
  Home: `<svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7m-9 2v8m4-8v8m5-8l2 2m-2-2v8a2 2 0 01-2 2H7a2 2 0 01-2-2v-8"></path></svg>`,
  "Start Here": `<svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>`,
  "AP State Board": `<svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16v-1a4 4 0 014-4h0a4 4 0 014 4v1m-8 0h8"></path></svg>`,
  "Example Activities": `<svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 21l3-1 3 1-.75-4M9 13V9a3 3 0 013-3h0a3 3 0 013 3v4"></path></svg>`,
};

const pinIcon = `<svg class="w-4 h-4 ml-2 text-yellow-400 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 19l6-6 6 6"></path></svg>`;

function isActive(item, pathname) {
  return item.link === pathname || (item.slug && pathname.endsWith(item.slug));
}

const { pathname } = Astro.url;

function groupHasActiveItem(group, pathname) {
  return group.items && group.items.some(item => isActive(item, pathname));
}
---

<aside class="bg-primary-900 text-primary-50 w-64 min-h-screen p-4 font-sans scrollbar-thin scrollbar-thumb-primary-700 scrollbar-track-primary-900 flex flex-col justify-between">
  <nav class="flex-1 overflow-y-auto">
    <ul class="space-y-2">
      {/* Pinned items section */}
      <li>
        <ul id="pinned-items" class="mb-2">
          {/* Pinned items will be injected here by client-side JS */}
        </ul>
      </li>
      {/* Divider */}
      <li><hr class="border-primary-800 my-2" /></li>
    </ul>
    {/* Main sidebar groups in a single accordion parent */}
    <ul id="sidebar-accordion" data-accordion="collapse">
      {Array.isArray(sidebar) && sidebar.length > 0 ? (
        sidebar.map((group, idx) =>
          group.items ? (
            <li>
              <h2 id={`accordion-heading-${idx}`}>
                <button
                  type="button"
                  class={`flex items-center w-full font-heading text-lg mb-2 text-left focus:outline-none transition-colors duration-200 ${
                    groupHasActiveItem(group, pathname) ? "bg-primary-800" : ""
                  }`}
                  data-accordion-target={`#accordion-panel-${idx}`}
                  aria-expanded={groupHasActiveItem(group, pathname) ? "true" : "false"}
                  aria-controls={`accordion-panel-${idx}`}
                >
                  <span class="mr-2" set:html={icons[group.label] || "•"}></span>
                  {group.label}
                  <svg class="ml-auto w-4 h-4 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
              </h2>
              <div
                id={`accordion-panel-${idx}`}
                class={groupHasActiveItem(group, pathname) ? "transition-all duration-300" : "hidden transition-all duration-300"}
                aria-labelledby={`accordion-heading-${idx}`}
              >
                <ul>
                  {group.items.map((item) => (
                    <li class="flex items-center justify-between group">
                      <a
                        href={item.link || `/` + item.slug}
                        class={`block px-3 py-2 rounded transition-colors font-body ${
                          isActive(item, pathname)
                            ? "bg-primary-600 text-white"
                            : "hover:bg-primary-700 hover:text-primary-50"
                        }`}
                      >
                        {item.label}
                      </a>
                      {/* Pin icon for favorite links */}
                      <button
                        type="button"
                        class="opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                        aria-label="Pin"
                        onclick={`window.pinSidebarItem && window.pinSidebarItem('${item.label}', '${item.link || '/' + item.slug}')`}
                      >
                        <span set:html={pinIcon}></span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
              {/* Divider after each group except last */}
              {idx < sidebar.length - 1 && <hr class="border-primary-800 my-2" />}
            </li>
          ) : (
            <li>
              <a
                href={group.link}
                class={`flex items-center px-3 py-2 rounded transition-colors font-body ${
                  isActive(group, pathname)
                    ? "bg-primary-600 text-white"
                    : "hover:bg-primary-700 hover:text-primary-50"
                }`}
              >
                <span class="mr-2" set:html={icons[group.label] || "•"}></span>
                {group.label}
              </a>
            </li>
          )
        )
      ) : (
        <li>No sidebar items found.</li>
      )}
    </ul>
  </nav>
  {/* Sidebar footer */}
  <footer class="mt-4 pt-4 border-t border-primary-800 flex flex-col items-center space-y-2">
    <div class="flex space-x-3">
      <a href="https://bsky.app/profile/sredsol.bsky.social" target="_blank" rel="noopener" aria-label="Bluesky">
        <svg class="w-5 h-5 text-primary-400 hover:text-primary-200" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /></svg>
      </a>
      <a href="https://github.com/sredsol" target="_blank" rel="noopener" aria-label="GitHub">
        <svg class="w-5 h-5 text-primary-400 hover:text-primary-200" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.012c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.53 2.341 1.088 2.91.832.091-.646.35-1.088.636-1.34-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.254-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.295 2.747-1.025 2.747-1.025.546 1.378.202 2.396.099 2.65.64.7 1.028 1.595 1.028 2.688 0 3.847-2.337 4.695-4.566 4.944.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.749 0 .268.18.579.688.481C19.138 20.175 22 16.427 22 12.012 22 6.484 17.523 2 12 2z"/></svg>
      </a>
    </div>
    <div>
      <button
        class="bg-primary-700 text-primary-50 px-2 py-1 rounded hover:bg-primary-600 transition-colors"
        aria-label="Toggle theme"
        onclick="window.toggleTheme()"
      >
        Theme
      </button>
    </div>
    <div class="text-xs text-primary-400">&copy; {new Date().getFullYear()} sredsol docs</div>
  </footer>
</aside>

<script is:inline src="https://unpkg.com/flowbite@latest/dist/flowbite.min.js"></script>
<script is:inline>
{`
window.pinSidebarItem = function(label, link) {
  let pinned = JSON.parse(localStorage.getItem('pinnedSidebarItems') || '[]');
  if (!pinned.some(item => item.label === label && item.link === link)) {
    pinned.push({ label, link });
    localStorage.setItem('pinnedSidebarItems', JSON.stringify(pinned));
    window.renderPinnedSidebarItems();
  }
};

window.renderPinnedSidebarItems = function() {
  const pinned = JSON.parse(localStorage.getItem('pinnedSidebarItems') || '[]');
  const container = document.getElementById('pinned-items');
  if (!container) return;
  container.innerHTML = '';
  const pinSvg = '<svg class="w-4 h-4 ml-2 text-yellow-400 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 19l6-6 6 6"></path></svg>';
  pinned.forEach(item => {
    const li = document.createElement('li');
    li.className = 'flex items-center px-3 py-2 rounded transition-colors font-body bg-primary-800 mb-1';
    const a = document.createElement('a');
    a.href = item.link;
    a.textContent = item.label;
    a.className = 'text-primary-50';
    li.appendChild(a);
    const unpinBtn = document.createElement('button');
    unpinBtn.innerHTML = pinSvg;
    unpinBtn.className = 'ml-2';
    unpinBtn.onclick = function() {
      window.unpinSidebarItem(item.label, item.link);
    };
    li.appendChild(unpinBtn);
    container.appendChild(li);
  });
};
window.unpinSidebarItem = function(label, link) {
  let pinned = JSON.parse(localStorage.getItem('pinnedSidebarItems') || '[]');
  pinned = pinned.filter(item => !(item.label === label && item.link === link));
  localStorage.setItem('pinnedSidebarItems', JSON.stringify(pinned));
  window.renderPinnedSidebarItems();
};
window.addEventListener('DOMContentLoaded', window.renderPinnedSidebarItems);
`}
</script>
<script is:inline>
{`
function applyTheme() {
  const theme = localStorage.getItem('theme');
  if (theme === 'dark') {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
}

window.toggleTheme = function() {
  const isDark = document.documentElement.classList.contains('dark');
  localStorage.setItem('theme', isDark ? 'light' : 'dark');
  applyTheme();
};

window.addEventListener('DOMContentLoaded', applyTheme);
`}
</script>
